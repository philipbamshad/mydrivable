{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yrgurlpeuisybzwoyrjx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "drivable-mcp",
      "version": "0.1.0",
      "title": "Drivable"
    },
    "tools": [
      {
        "name": "list_threads",
        "title": "List chat threads",
        "description": "List the signed-in user's Drivable chat threads, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_thread_messages",
        "title": "Get thread messages",
        "description": "Get all messages in one of the signed-in user's Drivable chat threads.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "threadId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Thread ID from list_threads."
            }
          },
          "required": [
            "threadId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_thread",
        "title": "Create chat thread",
        "description": "Create a new empty Drivable chat thread for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "description": "Optional thread title.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
